    <mn>2</mn>
    <mn>5</mn>
  </mfrac>
</math>
<math>
<mrow>
  <mo>(</mo>
  <mn>1</mn>
  <mo>+</mo>
  <mfrac>
    <mn>2</mn>
    <mn>5</mn>
  </mfrac>
  <mo>)</mo>
</mrow>
</math>
::

